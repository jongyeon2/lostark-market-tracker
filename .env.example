# Copy this file to .env (gitignored) and fill in real values for local development.
# Both docker-compose (for the containers) AND `./gradlew bootRun` (via build.gradle, which loads
# this file into the app JVM) read these variables. Real shell env vars take precedence over .env.

# PostgreSQL (local dev defaults)
POSTGRES_DB=lostark
POSTGRES_USER=lostark
POSTGRES_PASSWORD=lostark
POSTGRES_URL=jdbc:postgresql://localhost:5432/lostark

# Redis (local dev defaults)
REDIS_HOST=localhost
REDIS_PORT=6379

# Lostark Developer Portal API key (JWT).
# The REAL key must be set in .env ONLY — never commit it. Leave empty here.
LOSTARK_API_KEY=

# Admin shared secret guarding /api/admin/** (sent as the X-Admin-Secret header).
# The REAL value must be set in .env ONLY — never commit it. Leave empty here.
# Blank/unset => the admin gate fails CLOSED (every /api/admin/** request is 401).
ADMIN_API_SECRET=
