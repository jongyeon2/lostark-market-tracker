# Prod 시크릿 템플릿(Phase 18). `cp .env.prod.example .env.prod` 후 실값을 입력한다.
# ⚠️ .env.prod은 절대 커밋 금지(.gitignore가 무시). 실 시크릿은 배포 VM에만 존재해야 한다.
# 기동: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# PostgreSQL
POSTGRES_DB=lostark
POSTGRES_USER=lostark
POSTGRES_PASSWORD=          # openssl rand -hex 32 (dev 기본 'lostark' 금지)

# Redis (requirepass)
REDIS_PASSWORD=             # openssl rand -hex 32

# Lostark 개발자 포털 JWT (재발급 가능)
LOSTARK_API_KEY=

# 관리자 시크릿(X-Admin-Secret). openssl rand -hex 32 — dev의 123456789 절대 금지.
ADMIN_API_SECRET=

# Caddy: DuckDNS 도메인 + Let's Encrypt 계정 이메일
SITE_ADDRESS=your-sub.duckdns.org
ACME_EMAIL=you@example.com

# ── DB 백업(scripts/backup-db.sh, cron 하루 1회). 설정 절차는 런북 §11.
# 오브젝트 스토리지 버킷 PAR — ⚠️ 반드시 "쓰기 전용"(Permit object writes)으로 발급한다.
# 읽기·목록 권한을 주면 VM이 털렸을 때 기존 백업까지 읽히고 지워져 백업의 존재 이유가 무너진다.
# `/o/`로 끝나야 한다. 만료일이 있으므로 지나면 백업이 멈춘다 → 아래 PING이 그걸 잡는다.
BACKUP_PAR_URL=

# 데드맨 스위치(healthchecks.io 등). 백업이 "성공했을 때만" 호출되므로,
# 신호가 끊기면 = 백업이 안 되고 있다는 뜻이다. 25시간 무신호 알림 권장.
BACKUP_PING_URL=

# ── POSTGRES_URL / REDIS_HOST / REDIS_PORT은 docker-compose.prod.yml이 내부 서비스명
#    (postgres / redis)으로 세팅하므로 여기서 지정하지 않는다.
