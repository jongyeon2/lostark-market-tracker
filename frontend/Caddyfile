# Caddy(Phase 18): 유일한 공개 진입점. DuckDNS 도메인({$SITE_ADDRESS})에서 Let's Encrypt
# 자동 HTTPS(HTTP→HTTPS 강제)를 받고, 프론트는 정적으로 직접 서빙, /api·/actuator만 앱으로 프록시.
# 동일 출처라 CORS 불필요(frontend/src/lib/api.ts가 이미 상대 /api 사용).
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	# API + actuator → Spring Boot 앱(내부 docker 네트워크 서비스명 app:8080)
	handle /api/* {
		reverse_proxy app:8080
	}
	handle /actuator/* {
		reverse_proxy app:8080
	}

	# 정적 SPA + 클라이언트 라우팅 fallback(/timeline·/impact·/admin 새로고침 대응)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# 보안 헤더
	# CSP는 라이브 실자산 대조로 검증(quick 260713-e1o): 진입 script/stylesheet/폰트는 self 번들,
	# Recharts 런타임 inline style 때문에 style-src에 'unsafe-inline' 필수, 이미지는 self+로스트아크 CDN,
	# API는 same-origin(connect 'self'). unsafe-eval은 미포함 — 번들의 eval은 라이브러리 일회성
	# 기능 프로브(무해)이고 막아도 차트/Select 정상 동작 확인.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn-lostark.game.onstove.com; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}
